# --- Server ---
PORT=3000                 # HTTP listen port (default 3000)
TIME_SKEW_SEC=120         # allowed timestamp window + nonce TTL, seconds (default 120)
SNS_TIMEOUT_MS=5000       # per-provider send timeout, ms (default 5000)

# --- Signing (REQUIRED) ---
# Shared HMAC-SHA256 secret. Client signs `${ts}.${nonce}.${rawBody}` with this.
# Generate one: openssl rand -hex 32
SIGN_SECRET=

# --- Telegram provider ---
TG_BOT_TOKEN=             # from @BotFather
TG_CHAT_ID=               # target chat / channel id

# --- LINE provider ---
LINE_CHANNEL_ACCESS_TOKEN=   # Messaging API channel access token
LINE_TARGET_ID=              # user / group id to push to
